{
  "name": "dsh-deepseek-web-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Open the free DeepSeek web chat (chat.deepseek.com) inside DeepSeek Harness through a loopback reverse proxy.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "web-chat"
  ],
  "license": "MIT",
  "author": "xubin0628",
  "homepage": "https://github.com/xubin0628/dsh-deepseek-web-chat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xubin0628/dsh-deepseek-web-chat.git"
  },
  "bugs": {
    "url": "https://github.com/xubin0628/dsh-deepseek-web-chat/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "proxy.js",
    "cookies.js",
    "session-store.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  }
}
